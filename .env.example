# Neon pooled connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Required on Vercel Preview deployments. Point this at a separate Neon branch;
# preview builds deliberately fail closed when this variable is absent.
PREVIEW_DATABASE_URL=postgresql://preview_user:password@preview_host/database?sslmode=require

# Optional comparison guard. If set, previews refuse to use this exact URL.
PRODUCTION_DATABASE_URL=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (Resend)
# EMAIL_FROM must use a verified Resend domain. EMAIL_REPLY_TO should be a
# monitored mailbox or forwarding alias. See docs/email-deliverability.md.
# Production: set BETTER_AUTH_URL and NEXT_PUBLIC_SITE_URL to https://www.peerslot.com.
RESEND_API_KEY=
EMAIL_FROM=PeerSlot <notifications@peerslot.com>
EMAIL_REPLY_TO=
