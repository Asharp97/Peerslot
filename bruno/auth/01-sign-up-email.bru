meta {
  name: Sign up with email
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/sign-up/email
  body: json
  auth: none
}

headers {
  content-type: application/json
  origin: {{baseUrl}}
}

body:json {
  {
    "name": "{{testName}}",
    "email": "{{testEmail}}",
    "password": "{{testPassword}}",
    "termsAccepted": true
  }
}

tests {
  test("account is created or already exists", function () {
    expect(res.getStatus()).to.be.oneOf([200, 422]);
    if (res.getStatus() === 200) {
      expect(res.getBody().user.email).to.equal(bru.getEnvVar("testEmail"));
    }
  });
}
